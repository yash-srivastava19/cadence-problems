api_version: cadence/v1alpha2
program: scrabble/player.py
run: python -m scrabble.score
guidance: scrabble/IMPROVE.md
experiment: scrabble-search-vs-recall

metrics:
  win_rate: maximize
  spread: maximize
  forfeits: minimize
  vs_greedy: maximize
  vs_champion_1: maximize
  ms_per_move: minimize
  timeouts: minimize

objective:
  weighted_sum: {win_rate: 1.0}

budget:
  trials: 5

model:
  gemini: {model: gemini-3.5-flash}

sandbox:
  seconds: 400
  memory_mb: 1024
  seeds: [0, 1]

prompt:
  # One hint for every trial in both arms, so trial 0 is never told to keep
  # behaviour the same. See rounds/PREREG.md, 2026-10-04.
  hints: ["play better than the current champion; the moves it chooses must change"]
