api_version: cadence/v1alpha2
program: pack.py
experiment: circle-packing-26

# score.py is what runs; pack.py is what gets edited. Keeping them apart is
# what stops a candidate from scoring itself.
run: python score.py

metrics:
  sum_radii: maximize

budget:
  trials: 20
  usd: 2.0

model:
  gemini:
    # providers.yml gives gemini a 120s row, below cadence's own 300 default.
    # Two of the four calls on 2026-09-07 took 194s and 248s.
    timeout: 300
    attempts: 4

sandbox:
  # Not 30. The two candidates that beat the baseline on 2026-09-07 took 41.9s
  # and 59.4s to score; a 30s limit killed both and the run read as "the search
  # is weak". A sandbox limit that any winner can hit is not a safety rail, it
  # is a hidden term in the objective.
  seconds: 120
  memory_mb: 512

# verifier.tolerance is deliberately absent. Packing solutions are usually
# stochastic, so the same program can score differently twice; declaring a
# tolerance would switch on the verdict cache and freeze whichever score a
# candidate happened to get first.
