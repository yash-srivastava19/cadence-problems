# A second lineage, seeded with run 20260908-030111-f02ae0's winner.
# --config replaces the manifest, so every field is repeated here.
api_version: cadence/v1alpha2
program: heuristic.py
experiment: bin-packing-online
run: python score.py

metrics:
  excess_train: minimize
  excess_valid: minimize

objective:
  weighted_sum:
    excess_valid: -1.0

budget:
  trials: 24
  usd: 2.0

model:
  gemini:
    timeout: 300
    attempts: 4

sandbox:
  seconds: 60
  memory_mb: 512
  seeds: [0]

verifier:
  tolerance: 1e-9
